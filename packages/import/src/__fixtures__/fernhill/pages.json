 {
  "id": 9,
  "slug": "contact",
  "link": "https://fernhill.example/contact/",
  "title": {
   "rendered": "Contact"
  },
  "content": {
   "rendered": "\n<p>Questions about orders or classes? Send us a note.</p>\n<div class=\"wpcf7 js\" id=\"wpcf7-f12-p9-o1\" lang=\"en-GB\" dir=\"ltr\"><form action=\"/contact/#wpcf7-f12-p9-o1\" method=\"post\" class=\"wpcf7-form init\" aria-label=\"Contact form\">\n<div style=\"display: none;\"><input type=\"hidden\" name=\"_wpcf7\" value=\"12\" /></div>\n<p><label> Your name<br /><span class=\"wpcf7-form-control-wrap\" data-name=\"your-name\"><input size=\"40\" class=\"wpcf7-form-control wpcf7-text wpcf7-validates-as-required\" aria-required=\"true\" value=\"\" type=\"text\" name=\"your-name\" /></span></label></p>\n<p><label> Your email<br /><span class=\"wpcf7-form-control-wrap\" data-name=\"your-email\"><input size=\"40\" class=\"wpcf7-form-control wpcf7-email\" aria-required=\"true\" value=\"\" type=\"email\" name=\"your-email\" /></span></label></p>\n<p><label> Topic<br /><select name=\"topic\"><option value=\"\">—</option><option>Orders</option><option>Classes</option></select></label></p>\n<p><label> Your message<br /><textarea cols=\"40\" rows=\"10\" name=\"your-message\"></textarea></label></p>\n<p><input class=\"wpcf7-form-control wpcf7-submit\" type=\"submit\" value=\"Send message\" /></p>\n</form></div>\n<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2483!2d-1.2577!3d51.7520!2m3!1f0!2f0!3f0\" width=\"600\" height=\"450\" loading=\"lazy\"></iframe>\n"
