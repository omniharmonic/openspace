 {
  "id": 7,
  "slug": "classes",
  "link": "https://fernhill.example/classes/",
  "title": {
   "rendered": "Classes"
  },
  "content": {
   "rendered": "\n<p>Our classes run on Saturday afternoons for up to eight people.</p>\n<details class=\"wp-block-details\"><summary>Do I need any experience?</summary><p>None at all: we start from the very beginning.</p></details>\n<details class=\"wp-block-details\"><summary>What should I bring?</summary><p>Just an apron. We provide everything else, including a loaf to take home.</p></details>\n<div class=\"wp-block-buttons\"><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://fernhill.example/contact/\">Ask about dates</a></div></div>\n[booking_widget id=\"4\"]\n"
  },
  "excerpt": {
   "rendered": ""
  },
  "parent": 0,
  "menu_order": 3,
  "featured_media": 0,
  "_embedded": {}
 },
