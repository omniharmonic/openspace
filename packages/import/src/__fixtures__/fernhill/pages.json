 {
  "id": 2,
  "slug": "home",
  "link": "https://fernhill.example/",
  "title": {
   "rendered": "Home"
  },
  "content": {
   "rendered": "\n<div class=\"wp-block-cover alignfull\" style=\"min-height:80vh\"><span class=\"wp-block-cover__background has-background-dim\"></span><img class=\"wp-block-cover__image-background wp-image-30\" alt=\"\" src=\"https://fernhill.example/wp-content/uploads/2024/01/oven-1024x683.jpg\" srcset=\"https://fernhill.example/wp-content/uploads/2024/01/oven-1024x683.jpg 1024w, https://fernhill.example/wp-content/uploads/2024/01/oven-2048x1365.jpg 2048w\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\">\n<p class=\"has-small-font-size\">Since 2019</p>\n<h1 class=\"wp-block-heading has-text-align-center\">Slow bread from a small oven</h1>\n<p class=\"has-text-align-center\">Naturally leavened loaves, baked every morning in Fernhill.</p>\n<div class=\"wp-block-buttons\"><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://fernhill.example/classes/\">Book a class</a></div><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://fernhill.example/about/\">Our story</a></div></div>\n</div></div>\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#f1e6d6\">\n<h2 class=\"wp-block-heading\">What we bake</h2>\n<div class=\"wp-block-columns\">\n<div class=\"wp-block-column\" style=\"flex-basis:33.33%\"><h3 class=\"wp-block-heading\">Sourdough</h3><p>Country loaves with a 36-hour ferment and a deep, blistered crust.</p></div>\n<div class=\"wp-block-column\" style=\"flex-basis:33.33%\"><h3 class=\"wp-block-heading\">Pastries</h3><p>Laminated by hand: croissants, cardamom buns and seasonal danishes.</p></div>\n<div class=\"wp-block-column\" style=\"flex-basis:33.33%\"><h3 class=\"wp-block-heading\">Classes</h3><p>Small weekend classes where you shape and bake your own loaf.</p></div>\n</div></div>\n<figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped\">\n<figure class=\"wp-block-image size-large\"><img src=\"https://fernhill.example/wp-content/uploads/2024/02/loaves-1024x682.jpg\" srcset=\"https://fernhill.example/wp-content/uploads/2024/02/loaves-1024x682.jpg 1024w, https://fernhill.example/wp-content/uploads/2024/02/loaves-2048x1365.jpg 2048w, https://fernhill.example/wp-content/uploads/2024/02/loaves-300x200.jpg 300w\" width=\"2000\" height=\"1333\" alt=\"Loaves cooling on a rack\" class=\"\" loading=\"lazy\"/></figure>\n<figure class=\"wp-block-image size-large\"><img src=\"https://fernhill.example/wp-content/uploads/2024/02/buns-1024x682.jpg\" srcset=\"https://fernhill.example/wp-content/uploads/2024/02/buns-1024x682.jpg 1024w, https://fernhill.example/wp-content/uploads/2024/02/buns-2048x1365.jpg 2048w, https://fernhill.example/wp-content/uploads/2024/02/buns-300x200.jpg 300w\" width=\"2000\" height=\"1333\" alt=\"Cardamom buns\" class=\"\" loading=\"lazy\"/><figcaption class=\"wp-element-caption\">Cardamom buns, Saturdays only</figcaption></figure>\n<figure class=\"wp-block-image size-large\"><img src=\"https://fernhill.example/wp-content/uploads/2024/02/flour-1024x682.jpg\" srcset=\"https://fernhill.example/wp-content/uploads/2024/02/flour-1024x682.jpg 1024w, https://fernhill.example/wp-content/uploads/2024/02/flour-2048x1365.jpg 2048w, https://fernhill.example/wp-content/uploads/2024/02/flour-300x200.jpg 300w\" width=\"2000\" height=\"1333\" alt=\"Flour on the bench\" class=\"\" loading=\"lazy\"/></figure>\n</figure>\n<figure class=\"wp-block-pullquote\"><blockquote><p>The best bread in the county, and the kindest bakers.</p><cite>Local Food Guide</cite></blockquote></figure>\n<h2 class=\"wp-block-heading\">From the journal</h2>\n<ul class=\"wp-block-latest-posts__list wp-block-latest-posts\"><li><a class=\"wp-block-latest-posts__post-title\" href=\"https://fernhill.example/2025/09/rye-season/\">Rye season</a></li><li><a class=\"wp-block-latest-posts__post-title\" href=\"https://fernhill.example/2025/03/our-first-loaf/\">Our first loaf</a></li></ul>\n"
  },
