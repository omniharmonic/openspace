  "content": {
   "rendered": "<div class=\"wp-block-media-text alignwide is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img src=\"https://fernhill.example/wp-content/uploads/2024/02/rosa-1024x1280.jpg\" srcset=\"https://fernhill.example/wp-content/uploads/2024/02/rosa-1024x1280.jpg 1024w, https://fernhill.example/wp-content/uploads/2024/02/rosa-2048x2560.jpg 2048w, https://fernhill.example/wp-content/uploads/2024/02/rosa-300x375.jpg 300w\" width=\"1200\" height=\"1500\" alt=\"Rosa, head baker\" class=\"\" loading=\"lazy\"/></figure><div class=\"wp-block-media-text__content\"><h2 class=\"wp-block-heading\">Rosa Lind</h2><p>Head baker and keeper of Gus the starter since day one.</p></div></div>"
