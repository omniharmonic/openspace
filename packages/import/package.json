{
  "name": "@omniharmonic/openspace-import",
  "version": "0.1.2",
  "private": true,
  "description": "Move an existing website into OpenSpace from anywhere: the Squarespace, WordPress and generic HTML importers behind `openspace import`.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-lint": "workspace:*",
    "@omniharmonic/openspace-mcp-tools": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "liquidjs": "10.29.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "^8.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
