{
  "name": "@omniharmonic/openspace-mcp-tools",
  "version": "0.1.17",
  "description": "OpenSpace mcp-tools package.",
  "license": "MIT",
  "author": "The OpenSpace contributors",
  "homepage": "https://github.com/omniharmonic/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/openspace.git",
    "directory": "packages/mcp-tools"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/openspace/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-lint": "workspace:*",
    "@omniharmonic/openspace-ops": "workspace:*",
    "@omniharmonic/openspace-renderer": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "zod": "^4.6.7"
  }
}
