{
  "name": "@omniharmonic/openspace-theme",
  "version": "0.1.11",
  "description": "OpenSpace design tokens: OKLCH palettes, contrast solver, type pairings and the Site Styles compiler.",
  "license": "MIT",
  "author": "The OpenSpace contributors",
  "homepage": "https://github.com/omniharmonic/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/openspace.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/openspace/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@omniharmonic/openspace-schema": "workspace:*"
  }
}
