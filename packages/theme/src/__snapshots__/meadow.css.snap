@media (prefers-reduced-motion: reduce) {
  :root {
    --os-motion-enabled: 0;
    --os-motion-duration-fast: 0ms;
    --os-motion-duration-base: 0ms;
    --os-motion-duration-slow: 0ms;
    --os-motion-reveal-distance: 0px;
    --os-motion-reveal-duration: 0ms;
    --os-motion-stagger: 0ms;
    --os-motion-hover-scale: 1;
    --os-motion-parallax: 0;
  }
}
