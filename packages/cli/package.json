{
  "name": "@omniharmonic/openspace-cli",
  "version": "0.1.14",
  "description": "The openspace command line: check, dev, migrate, new, import, eject, agents-md, mcp.",
  "license": "MIT",
  "author": "The OpenSpace contributors",
  "homepage": "https://github.com/omniharmonic/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/openspace.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/openspace/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "openspace": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-import": "workspace:*",
    "@omniharmonic/openspace-lint": "workspace:*",
    "@omniharmonic/openspace-mcp-tools": "workspace:*",
    "@omniharmonic/openspace-ops": "workspace:*",
    "@omniharmonic/openspace-renderer": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "@omniharmonic/openspace-template-starter": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "1.64.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "bin": {
    "openspace": "./dist/bin.js"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
