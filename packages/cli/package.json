{
  "name": "@openspace/cli",
  "version": "0.1.0",
  "description": "The openspace command line: check, dev, migrate, new, eject, agents-md.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "openspace": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@openspace/blocks": "workspace:*",
    "@openspace/schema": "workspace:*",
    "@openspace/site-kit": "workspace:*",
    "@openspace/template-starter": "workspace:*",
    "commander": "^14.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "bin": {
    "openspace": "./dist/bin.js"
  }
}
