{
  "name": "@omniharmonic/openspace-site-kit",
  "version": "0.1.6",
  "description": "OpenSpace site-kit: the Astro integration that builds and publishes an OpenSpace site.",
  "license": "MIT",
  "author": "The OpenSpace contributors",
  "homepage": "https://github.com/omniharmonic/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/openspace.git",
    "directory": "packages/site-kit"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/openspace/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdoc": {
      "types": "./src/markdoc.ts",
      "default": "./src/markdoc.ts"
    },
    "./pages": {
      "types": "./src/pages.ts",
      "default": "./src/pages.ts"
    },
    "./content": {
      "types": "./src/content/index.ts",
      "default": "./src/content/index.ts"
    },
    "./render": {
      "types": "./src/render-entry.ts",
      "default": "./src/render-entry.ts"
    },
    "./route": {
      "types": "./src/runtime/route.ts",
      "default": "./src/runtime/route.ts"
    },
    "./cloudflare": {
      "types": "./src/cloudflare/index.ts",
      "default": "./src/cloudflare/index.ts"
    },
    "./cloudflare/gated": {
      "types": "./src/cloudflare/endpoints/gated.ts",
      "default": "./src/cloudflare/endpoints/gated.ts"
    },
    "./cloudflare/auth-callback": {
      "types": "./src/cloudflare/endpoints/auth-callback.ts",
      "default": "./src/cloudflare/endpoints/auth-callback.ts"
    },
    "./cloudflare/password": {
      "types": "./src/cloudflare/endpoints/password.ts",
      "default": "./src/cloudflare/endpoints/password.ts"
    },
    "./images-manifest": {
      "types": "./src/runtime/images-manifest.ts",
      "default": "./src/runtime/images-manifest.ts"
    },
    "./agents-md": {
      "types": "./src/agents-md.ts",
      "default": "./src/agents-md.ts"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./src/ids.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./markdoc": {
        "types": "./dist/markdoc.d.ts",
        "default": "./dist/markdoc.js"
      },
      "./pages": {
        "types": "./dist/pages.d.ts",
        "default": "./dist/pages.js"
      },
      "./content": {
        "types": "./dist/content/index.d.ts",
        "default": "./dist/content/index.js"
      },
      "./render": {
        "types": "./dist/render-entry.d.ts",
        "default": "./dist/render-entry.js"
      },
      "./route": {
        "types": "./dist/runtime/route.d.ts",
        "default": "./dist/runtime/route.js"
      },
      "./cloudflare": {
        "types": "./dist/cloudflare/index.d.ts",
        "default": "./dist/cloudflare/index.js"
      },
      "./cloudflare/gated": {
        "types": "./dist/cloudflare/endpoints/gated.d.ts",
        "default": "./dist/cloudflare/endpoints/gated.js"
      },
      "./cloudflare/auth-callback": {
        "types": "./dist/cloudflare/endpoints/auth-callback.d.ts",
        "default": "./dist/cloudflare/endpoints/auth-callback.js"
      },
      "./cloudflare/password": {
        "types": "./dist/cloudflare/endpoints/password.d.ts",
        "default": "./dist/cloudflare/endpoints/password.js"
      },
      "./images-manifest": {
        "types": "./dist/runtime/images-manifest.d.ts",
        "default": "./dist/runtime/images-manifest.js"
      },
      "./agents-md": {
        "types": "./dist/agents-md.d.ts",
        "default": "./dist/agents-md.js"
      },
      "./ids": {
        "types": "./dist/ids.d.ts",
        "default": "./dist/ids.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@markdoc/markdoc": "^0.5.10",
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-renderer": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.27.7",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "astro": "^7.4.2"
  },
  "peerDependenciesMeta": {
    "@astrojs/cloudflare": {
      "optional": true
    }
  }
}
