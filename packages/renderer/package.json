{
  "name": "@omniharmonic/openspace-renderer",
  "version": "0.1.5",
  "description": "OpenSpace renderer: React page/section/block renderer, base stylesheet, HTML documents and vanilla behaviors.",
  "license": "MIT",
  "author": "The OpenSpace contributors",
  "homepage": "https://github.com/omniharmonic/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/openspace.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/openspace/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "./src/behaviors/*",
    "./dist/behaviors/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./os.css": "./dist/os.css",
    "./behaviors/*": "./dist/behaviors/*",
    "./behavior-source/*": {
      "types": "./src/behaviors/*.ts",
      "default": "./src/behaviors/*.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./os.css": "./dist/os.css",
      "./behaviors/*": "./dist/behaviors/*",
      "./behavior-source/*": "./dist/behaviors/*.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "esbuild": "^0.27.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
