          "fields": {
            "text": "Getting help",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Questions"
          },
          "column": 0,
          "variant": "plain"
        },
        {
          "id": "blk_xpjhgcesxb",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Not sure if a program is right for you? Call the front desk and we'll talk it through."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_tvtzak0k69",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Contact us",
            "link": {
              "type": "page",
              "page": "pg_rbmgfshm9y"
            },
            "role": "secondary"
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_hz7m2q9wst",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Do I need ID or proof of income for the pantry?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. Just give us your first name and zip code so we can plan how much food to order."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Is there a cost for Homework Harbor?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Never. Snacks, supplies and tutoring are free for every student who enrolls."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can renters ask for repairs?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Safe at Home is for homeowners, but we'll connect renters with the tenants' union and city inspectors."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you offer help in other languages?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Volunteers speak Spanish, Nepali and Arabic on pantry days, and we can arrange interpreters for repair visits."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "column": 1,
          "variant": "lines"
        }
      ]
    }
