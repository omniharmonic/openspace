          "type": "heading",
          "v": 1,
          "fields": {
            "text": "How a free repair works",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Safe at Home"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_nnadvtch76",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "heading": "Call or write to us",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Tell us what needs fixing. Homeowners aged 62 and over, or living with a disability, qualify."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "A volunteer visits",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A licensed contractor from our crew looks at the job and explains what we can do, usually within two weeks."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "We fix it, free",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Ramps, rails, roofs and furnaces are repaired by volunteers, with materials paid for by donors."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "columns": "3",
            "aspect": "original"
          },
          "variant": "steps"
        },
