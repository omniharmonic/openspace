        {
          "id": "blk_m3wwar31fz",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "How much of my gift goes to programs?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "94 cents of every dollar. Our annual report and audited accounts are on the About page."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I give in honor of someone?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Add their name at checkout and we'll send a card to them or their family."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you accept food donations?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Fresh produce, yes, on pantry mornings. For packaged food, a cash gift buys about three times as much."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": true
          },
          "variant": "cards"
