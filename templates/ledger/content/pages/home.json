          "id": "blk_w3v2bvk47k",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Operations reset",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A twelve-week project to map how work really flows, remove the bottlenecks and set up the few rituals and dashboards that keep it running."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Outcome: ",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "the founder spends half as many hours on day-to-day decisions."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Leadership hiring",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Defining the role, running the search alongside your recruiter and onboarding your first COO, head of operations or finance lead."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Outcome: ",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "a leader in seat within four months, with a 90-day plan."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Fractional COO",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Two days a week inside your team for six months, running the operating cadence while you hire or grow into the role."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Outcome: ",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "a steady quarter, and a playbook the next leader can inherit."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": true,
            "openFirst": true,
            "faqSchema": false
          },
          "column": 1,
          "variant": "lines"
