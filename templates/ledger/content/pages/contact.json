              "name": "Enquiry",
              "fields": [
                {
                  "type": "text",
                  "name": "name",
                  "label": "Name",
                  "required": true,
                  "width": "half"
                },
                {
                  "type": "email",
                  "name": "email",
                  "label": "Work email",
                  "required": true,
                  "width": "half"
                },
                {
                  "type": "text",
                  "name": "company",
                  "label": "Company",
                  "width": "half"
                },
                {
                  "type": "select",
                  "name": "size",
                  "label": "Team size",
