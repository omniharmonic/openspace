      "blocks": [
        {
          "id": "blk_xb7zk6j7fp",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Fewer meetings, clearer owners",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Approach",
            "subheading": "Most operational pain comes from decisions without owners. My work is mostly finding them and writing them down."
          },
          "variant": "split"
        },
        {
          "id": "blk_f5pjng2ngb",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I don't arrive with a framework to install. I start by listening: to the founder, to the managers and to the people closest to customers. Patterns appear quickly. The same three decisions always wait on the same person, and the same weekly meeting always runs long."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Then we change as little as possible. A clear owner for each decision, a short weekly rhythm and a single page of numbers fix more than any software rollout. When I leave, the new way of working is written down and owned by your team, not by me."
                    }
                  ]
                }
              ]
            }
          },
          "variant": "columns"
        }
      ]
    },
