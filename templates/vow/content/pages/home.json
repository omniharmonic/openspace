          "fields": {
            "text": "A wrong train and a long conversation",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Our story"
          },
          "column": 1,
          "variant": "plain"
        },
        {
          "id": "blk_zhrj7p1xbs",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We met in 2019 on the wrong train out of Oakland: Amara was heading to a job interview, Theo was heading home from a night shift, and both of us had misread the board. By the time we worked it out, we'd talked through four stops and missed two more."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Seven years, two apartments and one very opinionated cat later, Theo proposed on the same platform. We can't wait to celebrate with the people who made the years in between so good."
                    }
                  ]
                }
              ]
            }
          },
          "column": 1,
          "variant": "default"
        },
        {
          "id": "blk_6v3jhnjs9d",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Read our story",
            "link": {
              "type": "page",
              "page": "pg_1qkwpmqv9x"
            },
            "role": "secondary"
          },
          "column": 1,
          "variant": "default"
        }
      ]
    },
