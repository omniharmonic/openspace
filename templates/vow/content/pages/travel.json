          "fields": {
            "items": [
              {
                "question": "Is there parking at the ranch?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Very little, so please take the shuttle. It runs from both hotels from 3:15pm and back from 10pm."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Are children invited?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "We love your kids, but Saturday is adults only. The hotels can recommend local sitters."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What's the weather like in September?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Warm days around 80°F and cool evenings. Bring a layer for after sunset."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I bring a plus-one?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "If your invitation names a guest, yes! Their name will be on the RSVP form."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "column": 1,
          "variant": "lines"
