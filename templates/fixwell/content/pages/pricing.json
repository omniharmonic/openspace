                "question": "Why publish prices?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Because you should know roughly what a job costs before you pick up the phone."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What if the job takes longer?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Fixed-price jobs stay fixed. Hourly jobs never go over without your OK."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you offer finance?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "For renovations over $5,000, yes — twelve months interest-free."
                        }
                      ]
                    }
                  ]
                }
