            "items": [
              {
                "heading": "Start with the decision",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Every chart exists to help someone decide something. Find out what."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Fewer, truer numbers",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "One honest number beats ten impressive ones."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Test with real data",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Tidy sample charts lie. Prototype with the messy real thing."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Design is a team sport",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The best ideas usually come from engineers and users."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "columns": "2",
            "aspect": "3:2"
          },
          "column": 1,
          "variant": "steps"
