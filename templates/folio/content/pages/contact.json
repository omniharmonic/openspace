            "size": "auto",
            "eyebrow": "Roles & projects"
          },
          "column": 0,
          "variant": "plain"
        },
        {
          "id": "blk_g1zfnaxbsn",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A few lines about the team and the problem is plenty. I'll reply within two working days."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_rw6sypaneq",
          "type": "form",
          "v": 1,
          "fields": {
            "form": {
              "id": "frm_ehw4acqq7x",
              "name": "Role or project",
              "fields": [
                {
                  "type": "text",
                  "name": "name",
                  "label": "Your name",
                  "required": true,
                  "width": "half"
                },
                {
                  "type": "email",
                  "name": "email",
                  "label": "Email",
                  "required": true,
                  "width": "half"
                },
                {
                  "type": "text",
                  "name": "company",
                  "label": "Company",
                  "required": false,
                  "width": "full"
                },
                {
                  "type": "radio",
                  "name": "kind",
                  "label": "It's about",
                  "required": false,
                  "options": [
                    "A full-time role",
                    "A freelance project",
                    "Speaking"
                  ]
                },
                {
                  "type": "textarea",
                  "name": "message",
                  "label": "The team and the problem",
                  "required": true,
                  "maxLength": 3000
                }
              ],
              "submitLabel": "Send",
              "success": {
                "type": "message",
                "message": "Thanks — I'll reply within two working days."
              },
              "notifyOwner": true
            }
