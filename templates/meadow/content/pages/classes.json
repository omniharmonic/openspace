          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Before you come",
            "level": "h2",
            "size": "auto",
            "eyebrow": "First class"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_dnxcwdxze7",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "I've never done yoga. Which class should I take?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Foundations or Slow Flow. Both move gently and explain each pose, and your teacher will offer simpler options whenever you need them."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What should I bring?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Comfortable clothes and a water bottle. Mats, blocks, bolsters and blankets are all provided and cleaned between classes."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I come if I'm pregnant or recovering from an injury?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Tell your teacher before class. Prenatal Yoga is ideal from the second trimester, and our massage therapists can suggest classes that suit your recovery."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Is the studio accessible?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The main studio is on the ground floor with step-free access and an accessible restroom. The bodywork rooms are upstairs; ask us about ground-floor appointments."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": true
          },
          "variant": "minimal"
        }
      ]
