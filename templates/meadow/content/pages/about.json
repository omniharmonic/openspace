          "id": "blk_7dan89sf8e",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "A studio built around slowing down",
            "level": "h1",
            "size": "h1",
            "eyebrow": "Our story"
          },
          "column": 1,
          "variant": "plain"
        },
        {
          "id": "blk_eb14e06dgt",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Hana Moreau taught her first class in 2012, in a borrowed church hall with eight mats and a space heater. She had spent ten years as a nurse and had seen how rarely people are given time to notice their own bodies."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Fernwood opened in 2016 with one room, one teacher and a kettle. Today there are six teachers, two massage therapists and thirty classes a week, but the rules are the same: small classes, patient teaching, and tea afterwards for anyone who wants to stay."
                    }
                  ]
                }
              ]
            }
          },
          "column": 1,
          "variant": "default"
        },
        {
          "id": "blk_bw1b1yymfx",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Meet the teachers",
            "link": {
              "type": "page",
              "page": "pg_sat2c09jw4",
              "anchor": "teachers"
            },
            "role": "secondary"
          },
          "column": 1,
          "variant": "default"
        }
      ]
    },
