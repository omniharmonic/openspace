          "type": "heading",
          "v": 1,
          "fields": {
            "text": "A letter from a hill farm",
            "level": "h1",
            "size": "h1",
            "eyebrow": "About"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
