            "items": [
              {
                "question": "How often will I hear from you?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Every other Sunday morning, Eastern time. Never more, occasionally less in lambing season."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I read without subscribing?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Every essay goes up in the archive a day after it's sent."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I give a supporter subscription?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Of course. Write to me with their address and I'll send a card with the first anthology."
                        }
                      ]
