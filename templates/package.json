{
  "name": "@omniharmonic/openspace-templates",
  "private": true,
  "version": "1.0.0",
  "description": "OpenSpace launch templates: twelve complete sites (content, styles, media credits) with three looks each, and a typed registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "index.ts",
    "lib",
    "*/src",
    "*/openspace.json",
    "*/template.json",
    "*/content",
    "*/media",
    "!starter"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "UPDATE_TEMPLATES=1 vitest run test/generate.test.ts"
  },
  "dependencies": {
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@omniharmonic/openspace-cli": "workspace:*",
    "@omniharmonic/openspace-lint": "workspace:*",
    "@omniharmonic/openspace-renderer": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
