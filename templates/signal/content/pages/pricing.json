          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Billing questions",
            "level": "h2",
            "size": "auto",
            "eyebrow": "FAQ"
          },
          "variant": "plain"
        },
        {
          "id": "blk_dy4yrxcjhe",
          "type": "tabs",
          "v": 1,
          "fields": {
            "label": "Question topics",
            "items": [
              {
                "label": "Billing",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Who counts as a responder?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anyone who can be paged. Stakeholders who only read incidents and status pages are free."
                        }
                      ]
                    },
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Can I pay annually?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Annual plans get two months free and can be paid by invoice."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "label": "Trials",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Do I need a card to start a trial?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. You'll move to the Starter plan automatically if you don't upgrade."
                        }
                      ]
                    },
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Can I extend my trial?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Just ask. Most migrations finish within the first week anyway."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "label": "Security",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Do you support single sign-on?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "SAML and OIDC single sign-on with SCIM provisioning are included on the Scale plan."
                        }
                      ]
                    },
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3,
                        "preset": "h4"
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Can we sign a DPA?"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes, on every paid plan. Download it from your account settings."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "variant": "pills"
        }
      ]
    }
  ]
