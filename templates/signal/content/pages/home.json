        {
          "id": "blk_s1n0hv0gyh",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Which monitoring tools does Tidewire connect to?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Over 60, including Datadog, Grafana, Prometheus, Sentry, CloudWatch and any tool that can send a webhook."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can we migrate our existing schedules?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Import rotas from a CSV or from most on-call tools in a few minutes, overrides included."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Where is our data stored?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "In the US by default, or in the EU on the Scale plan. Everything is encrypted at rest and in transit."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What happens if Tidewire itself goes down?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Alerting runs in three regions with automatic failover. Our own status page is hosted independently."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "column": 1,
          "variant": "lines"
        }
      ]
    },
