          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Owned together, run in the open",
            "level": "h1",
            "size": "h1",
            "eyebrow": "About"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
