  "id": "pg_me0855hfs5",
  "title": "About",
  "slug": "about",
  "seo": {
    "description": "Wren Adeyemi founded Saltmarsh Pottery in 2017 in a 1920s boatshed in Mystic. The story of the studio, the clay and the glazes."
  },
  "sections": [
    {
      "id": "sec_rwb9r72ja6",
      "preset": "about/story-split@1",
      "label": "Story with portrait",
      "layout": {
        "mode": "stack",
        "columns": {
