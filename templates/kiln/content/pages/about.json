          "type": "image",
          "v": 1,
          "fields": {
            "image": {
              "src": "https://images.unsplash.com/photo-1780387477222-730504564368?w=1040&q=80",
              "alt": "Portrait of Wren Adeyemi, potter and founder of Saltmarsh",
              "width": 1040,
              "height": 1560
            },
            "aspect": "4:5",
            "lightbox": false
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_xmh4rj2pfs",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Hello, I'm Wren",
            "level": "h1",
            "size": "h1",
            "eyebrow": "The maker"
          },
          "column": 1,
          "variant": "plain"
        },
        {
          "id": "blk_pacydwyzjb",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I learned to throw at a night class in New Haven when I was forty-three, after twenty years as a school librarian. Within a year I'd bought a second-hand wheel; within three, I'd given notice and rented a leaking boatshed on the Mystic River."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Saltmarsh Pottery has lived there since 2017. I make everything myself, fire the kiln about once a month and mix glazes from wood ash, local clay and a lot of trial and error. The colours come from the marsh outside the window: oyster grey, cordgrass green, the rust of old mooring chains."
                    }
                  ]
                }
              ]
            }
          },
          "column": 1,
          "variant": "default"
        },
        {
          "id": "blk_yxbzx2353x",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Visit the studio",
            "link": {
              "type": "page",
              "page": "pg_qpse8ffgrr"
            },
            "role": "secondary"
          },
          "column": 1,
          "variant": "default"
        }
      ]
    },
    {
      "id": "sec_4485k5bzd4",
      "preset": "about/values@1",
      "label": "Values",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "gap": "xl"
      },
      "style": {
