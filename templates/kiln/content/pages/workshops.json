              {
                "heading": "Saturday: make",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Wedge, centre and throw on the wheel, with plenty of help. Most people make three to five pieces."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Sunday: trim",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Come back the next morning to trim your favourites and add handles or carved details."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Three weeks later: collect",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Choose a glaze; Wren fires everything twice and lets you know when your pots are ready."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
