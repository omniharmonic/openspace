          "fields": {
            "items": [
              {
                "question": "I've never touched clay. Is that OK?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Completely. Most of our students are beginners, and the first hour is all about centring."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What should I wear?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Clothes you don't mind getting muddy and short nails. Aprons and towels are provided."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I book the studio for a group?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes, for four to eight people on weekday evenings. Write to us with a date in mind."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
