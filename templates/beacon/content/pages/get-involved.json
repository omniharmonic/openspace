          "v": 1,
          "fields": {
            "text": "Before your first planting day",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Volunteering"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_js44ww9jpj",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Do I need any experience?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "None at all. A team leader shows every group what to do."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What should I wear?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Clothes and shoes you don't mind getting muddy. We provide gloves."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I bring my children?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes — children over six are welcome with an adult."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What if it rains?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "We plant in light rain. We'll text you if a day is cancelled."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": true
          },
