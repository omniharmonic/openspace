          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Keepers are the reason nine in ten of our trees survive. It takes about twenty minutes a week in summer."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_1qrctmm4bd",
          "type": "button",
          "v": 1,
