      "blocks": [
        {
          "id": "blk_mr24tpzmeb",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Every child in Eastport should grow up within a short walk of shade.",
            "level": "h1",
            "size": "h1",
            "eyebrow": "Our mission"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_38qyqdjwnb",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Trees are the cheapest way to cool a city. We plant them where people need them most."
                    }
                  ]
                }
              ]
            }
          },
          "variant": "default",
          "style": {
            "align": {
              "d": "center"
            }
          }
        }
      ]
