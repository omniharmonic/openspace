        },
        {
          "id": "blk_2z5g2pnmsz",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Is my donation tax-deductible?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Shade Street Trust is a registered charity and every gift gets a receipt."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I give in memory of someone?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes — tell us their name and we'll plant a tree and send a card."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can my company match my gift?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Many employers do. Ask your HR team and we'll send what they need."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "How do I cancel a monthly gift?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use the link in any receipt, or email us and we'll do it the same day."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "variant": "lines"
        },
