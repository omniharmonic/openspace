          "type": "heading",
          "v": 1,
          "fields": {
            "text": "What I believe about leading",
            "level": "h2",
            "size": "auto",
            "eyebrow": "My approach"
          },
          "column": 0,
          "variant": "plain"
        },
        {
          "id": "blk_362xpc27fr",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "heading": "Clarity is kindness",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Most team stress comes from unclear decisions, not hard ones."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Habits beat heroics",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Small weekly rhythms outlast any offsite."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "You set the weather",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A calm founder makes a calm company; the reverse is also true."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Rest is strategy",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Tired founders make expensive decisions."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "columns": "2",
            "aspect": "3:2"
          },
          "column": 1,
          "variant": "steps"
        }
      ]
    },
