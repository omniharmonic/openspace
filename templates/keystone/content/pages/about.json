      "blocks": [
        {
          "id": "blk_rf1p37tazr",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "The job nobody trains you for",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Why I coach"
          },
          "variant": "plain"
        },
        {
          "id": "blk_m9rxaavyzr",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "At twenty-nine I went from writing code to managing twelve people in about six weeks. Nobody told me how; I learned by getting it wrong, loudly."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "After selling the company I trained with the Co-Active institute and spent two years coaching founders for free while I learned the craft."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Now I work with around fifteen founders at a time. It's the best job I've had."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "— Nadia"
                    }
                  ]
                }
              ]
            }
          },
          "variant": "drop-cap"
        }
      ]
    },
    {
      "id": "sec_kjm9ff8s3k",
      "preset": "about/beliefs@1",
      "label": "What we believe",
      "layout": {
