{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Renamed to the site's repository name when Cloudflare hosting is connected.
  "name": "openspace-site",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Gated (members / password) page content — never stored in the public repository.
  // Provisioned automatically on the first deploy.
  "r2_buckets": [{ "binding": "OS_GATED" }],
  // Stock and orders for the store (Phase 5).
  "d1_databases": [{ "binding": "OS_DB" }],
  "observability": { "enabled": true }
}
