{
  "name": "@omniharmonic/openspace-template-starter",
  "private": true,
  "version": "0.1.0",
  "description": "OpenSpace starter: the thin Astro site shell (astro.config, page route, publish workflows, AGENTS.md).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "site",
    "variants"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agents-md": "UPDATE_AGENTS_MD=1 vitest run src/starter.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "yaml": "^2.9.1"
  }
}
