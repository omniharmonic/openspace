          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Cooking the way my nonna did",
            "level": "h1",
            "size": "h1",
            "eyebrow": "Our story"
          },
          "column": 1,
          "variant": "plain"
        },
        {
          "id": "blk_jnmf1nbgnj",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I grew up between Providence and my grandmother's village in Calabria, where dinner was cooked on a wood stove and nobody left the table early. After fifteen years cooking in Boston and Rome, I came home to Federal Hill to open the kind of place I always wanted to eat in."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Ember & Olive opened in 2019 with one oak-fired oven and twelve tables. We buy whole animals and whole crates of vegetables from farms within an hour of the restaurant, make every pasta by hand, and change the menu whenever the market does."
                    }
                  ]
                }
              ]
            }
          },
          "column": 1,
          "variant": "default"
        },
