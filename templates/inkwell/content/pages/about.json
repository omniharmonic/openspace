          "fields": {
            "text": "A short note on Slow Light",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Why I write"
          },
          "variant": "plain"
        },
        {
          "id": "blk_n742rj0zvc",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I started the newsletter during a long winter when I couldn't go far, so I wrote about what was near: the river, the allotment, the man who feeds the swans."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "It turned out a lot of people wanted to read about small things carefully observed. Thank you for being one of them."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Slow Light is free and always will be. If you'd like to support it, buy a book from your local shop."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "preset": "small"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "— June"
                    }
                  ]
                }
              ]
            }
          },
          "variant": "drop-cap"
        }
      ]
    },
