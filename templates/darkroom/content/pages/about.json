                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I learned to print in a basement darkroom in Philadelphia, then spent six years assisting editorial photographers before going on my own in 2014."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I still shoot a roll of film on every job, and every client gets one hand-printed photograph in the post."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0,
          "variant": "default"
