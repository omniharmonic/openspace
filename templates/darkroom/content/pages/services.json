                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Twelve at most, so each couple gets my full attention and their photos within three weeks."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you shoot film?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes — one or two rolls of black-and-white film alongside digital, at no extra cost."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Will you travel?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anywhere. Travel within two hours of New York is included; beyond that, at cost."
