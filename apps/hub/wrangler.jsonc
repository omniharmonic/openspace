{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openspace-hub",
  "main": "src/index.ts",
  // Keep at or below the workerd bundled with @cloudflare/vitest-pool-workers.
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // DEV_MODE=true: DevGitHubAccess (D1-emulated GitHub) + /auth/dev/login (Global Constraint 8).
    "DEV_MODE": "true",
    "HUB_URL": "http://localhost:8787",
    "STUDIO_ORIGIN": "http://localhost:5173",
    "GITHUB_APP_SLUG": "openspace",
    "LOG_LEVEL": "info"
  },
  // Secrets (wrangler secret put / .dev.vars): GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY,
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, TOKEN_ENC_KEY, GITHUB_WEBHOOK_SECRET.
  // See .dev.vars.example.
  "durable_objects": {
    "bindings": [{ "name": "DRAFT_ROOM", "class_name": "DraftRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DraftRoom"] }],
  // Scheduled publishes, transfer/invitation expiry and archived-site purges (arch §8.1).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "openspace-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }],
  // Production: real GitHub App, no dev sign-in. Bindings are not inherited by environments,
  // so they are repeated here (replace the ids with your own resources).
  "env": {
    "production": {
      "vars": {
        "DEV_MODE": "false",
        "HUB_URL": "https://hub.openspace.dev",
        "STUDIO_ORIGIN": "https://studio.openspace.dev",
        "GITHUB_APP_SLUG": "openspace",
        "LOG_LEVEL": "info"
      },
      "durable_objects": {
        "bindings": [{ "name": "DRAFT_ROOM", "class_name": "DraftRoom" }]
      },
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        {
          "binding": "HUB_DB",
          "database_name": "openspace-hub",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }]
    }
  }
}
