{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openspace-hub",
  "main": "src/index.ts",
  // Keep at or below the workerd bundled with @cloudflare/vitest-pool-workers.
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // DEV_MODE=true: DevGitHubAccess (D1-emulated GitHub) + /auth/dev/login (Global Constraint 8).
    "DEV_MODE": "true",
    "HUB_URL": "http://localhost:8787",
    "STUDIO_ORIGIN": "http://localhost:5173",
    "GITHUB_APP_SLUG": "openspace",
    "LOG_LEVEL": "info"
  },
  // Secrets (wrangler secret put / .dev.vars): GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY,
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, TOKEN_ENC_KEY. See .dev.vars.example.
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "openspace-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }],
  // Task 16: per-IP+site rate limiter for public endpoints (forms, newsletter).
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "rate-limiter-v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Task 16: per-visitor analytics beacon limit (Workers Rate Limiting API; local to each colo).
  "ratelimits": [
    { "name": "BEACON_LIMITER", "namespace_id": "1601", "simple": { "limit": 120, "period": 60 } }
  ],
  // Task 16: retention purge + daily form digests (03:00 UTC) and weekly analytics digests
  // (Mondays 08:00 UTC). The `scheduled` handler dispatches by cron string.
  "triggers": { "crons": ["0 3 * * *", "0 8 * * 1"] },
  // Production: real GitHub App, no dev sign-in. Bindings are not inherited by environments,
  // so they are repeated here (replace the ids with your own resources).
  "env": {
    "production": {
      "vars": {
        "DEV_MODE": "false",
        "HUB_URL": "https://hub.openspace.dev",
        "STUDIO_ORIGIN": "https://studio.openspace.dev",
        "GITHUB_APP_SLUG": "openspace",
        "LOG_LEVEL": "info"
      },
      "d1_databases": [
        {
          "binding": "HUB_DB",
          "database_name": "openspace-hub",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }],
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
      },
      "triggers": { "crons": ["0 3 * * *", "0 8 * * 1"] },
      "ratelimits": [
        {
          "name": "BEACON_LIMITER",
          "namespace_id": "1601",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      // Task 16: Hub-domain transactional mail (Cloudflare Email Service; onboard the sending
      // domain with `wrangler email sending enable`) and Analytics Engine for pageviews.
      // Secrets: EMAIL_FROM, TURNSTILE_SECRET, CF_ACCOUNT_ID, CF_ANALYTICS_TOKEN, HUB_SECRET
      // (or RESEND_API_KEY / POSTMARK_TOKEN with EMAIL_PROVIDER).
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "openspace_analytics" }]
    }
  }
}
