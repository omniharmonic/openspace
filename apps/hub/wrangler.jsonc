{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openspace-hub",
  "main": "src/index.ts",
  // Keep at or below the workerd bundled with @cloudflare/vitest-pool-workers.
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // DEV_MODE=true: DevGitHubAccess (D1-emulated GitHub) + /auth/dev/login (Global Constraint 8).
    "DEV_MODE": "true",
    "HUB_URL": "http://localhost:8787",
    "STUDIO_ORIGIN": "http://localhost:5173",
    "GITHUB_APP_SLUG": "openspace",
    "LOG_LEVEL": "info"
  },
  // Secrets (wrangler secret put / .dev.vars): GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY,
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, TOKEN_ENC_KEY, GITHUB_WEBHOOK_SECRET.
  // See .dev.vars.example.
  // DraftRoom (Task 15) + the per-IP+site rate limiter for public endpoints (Task 16).
  "durable_objects": {
    "bindings": [
      { "name": "DRAFT_ROOM", "class_name": "DraftRoom" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DraftRoom"] },
    { "tag": "rate-limiter-v1", "new_sqlite_classes": ["RateLimiter"] }
  ],
  // "* * * * *": scheduled publishes, transfer/invitation expiry, archived-site purges (Task 15).
  // "0 3 * * *": retention purge + daily form digests; "0 8 * * 1": weekly analytics digests
  // (Task 16). "0 4 * * *": update-bot checks + growth housekeeping (Task 18). The `scheduled`
  // handler dispatches by cron string; the minute cron also starts due campaigns (Task 18).
  "triggers": { "crons": ["* * * * *", "0 3 * * *", "0 8 * * 1", "0 4 * * *"] },
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "openspace-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" },
    // Task 17: OAuth 2.1 authorization server for MCP clients (@cloudflare/workers-oauth-provider).
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000001" }
  ],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }],
  // Task 16: per-visitor analytics beacon limit (Workers Rate Limiting API; local to each colo).
  "ratelimits": [
    { "name": "BEACON_LIMITER", "namespace_id": "1601", "simple": { "limit": 120, "period": 60 } }
  ],
  // MCP screenshots (`screenshot`, `screenshot_url`): DEV_MODE uses a placeholder image, so no
  // browser binding here (local runs and tests need no Cloudflare account). Production binds
  // Cloudflare Browser Rendering as BROWSER below; set the var SCREENSHOTS="off" to disable.
  // Production: real GitHub App, no dev sign-in. Bindings are not inherited by environments,
  // so they are repeated here (replace the ids with your own resources).
  "env": {
    "production": {
      "vars": {
        "DEV_MODE": "false",
        "HUB_URL": "https://hub.openspace.host",
        "STUDIO_ORIGIN": "https://studio.openspace.host",
        "GITHUB_APP_SLUG": "openspace",
        "LOG_LEVEL": "info"
      },
      "durable_objects": {
        "bindings": [
          { "name": "DRAFT_ROOM", "class_name": "DraftRoom" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "triggers": { "crons": ["* * * * *", "0 3 * * *", "0 8 * * 1", "0 4 * * *"] },
      "d1_databases": [
        {
          "binding": "HUB_DB",
          "database_name": "openspace-hub",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "00000000000000000000000000000000" },
        { "binding": "OAUTH_KV", "id": "00000000000000000000000000000001" }
      ],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "openspace-hub-uploads" }],
      "ratelimits": [
        {
          "name": "BEACON_LIMITER",
          "namespace_id": "1601",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      // Task 16: Hub-domain transactional mail (Cloudflare Email Service; onboard the sending
      // domain with `wrangler email sending enable`) and Analytics Engine for pageviews.
      // Secrets: EMAIL_FROM, TURNSTILE_SECRET, CF_ACCOUNT_ID, CF_ANALYTICS_TOKEN, HUB_SECRET
      // (or RESEND_API_KEY / POSTMARK_TOKEN with EMAIL_PROVIDER).
      "send_email": [{ "name": "EMAIL" }],
      // Remote MCP screenshots through Cloudflare Browser Rendering (@cloudflare/puppeteer).
      // Works on Workers Free (10 browser-minutes/day, 3 concurrent) — Workers Paid recommended
      // (10 browser-hours/month included, then $0.09/hour). See docs/ops/browser-rendering.md.
      "browser": { "binding": "BROWSER" },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "openspace_analytics" }]
      // Task 18 (optional): campaign fan-out through a Queue. Create it first
      // (`wrangler queues create openspace-campaigns`), then add:
      //   "queues": {
      //     "producers": [{ "binding": "CAMPAIGN_QUEUE", "queue": "openspace-campaigns" }],
      //     "consumers": [{ "queue": "openspace-campaigns", "max_batch_size": 5, "max_retries": 3 }]
      //   }
      // Without it, campaigns send inline in batches and the minute cron finishes large lists.
      // Secrets: STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET (Connect), MEMBER_JWT_PRIVATE_KEY
      // (optional; else generated and sealed with TOKEN_ENC_KEY).
    }
  }
}
