# Copy to .dev.vars for local secrets. None are needed in DEV_MODE (the default).
# To use a real GitHub App locally, set DEV_MODE="false" in wrangler.jsonc vars (or here) and fill:
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TOKEN_ENC_KEY=   # 32 random bytes, base64: openssl rand -base64 32
# GITHUB_WEBHOOK_SECRET=   # the GitHub App webhook secret; /webhooks/github rejects unsigned events without it

# Public services (Task 16). All optional; without them (or in DEV_MODE) email goes to the dev
# outbox at /dev/outbox, Turnstile is bypassed and analytics are stored in D1.
# EMAIL_FROM="OpenSpace <no-reply@hub.example.com>"
# EMAIL_PROVIDER=          # cloudflare | resend | postmark (default: whichever is configured)
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# CF_ACCOUNT_ID=           # Analytics Engine SQL reads (with the ANALYTICS binding)
# CF_ANALYTICS_TOKEN=
# HUB_SECRET=              # HMAC key for unsubscribe links (falls back to TOKEN_ENC_KEY)
# QUOTAS_JSON='{"formSubmissions":5000}'   # self-hosted quota overrides

# Growth + commerce (Task 18). All optional; in DEV_MODE checkout uses DevStripe (a fake checkout
# page on the Hub), campaigns go to the dev outbox and the update bot uses a built-in release.
# STRIPE_SECRET_KEY=        # platform key for Stripe Connect (Standard accounts, no fee)
# STRIPE_WEBHOOK_SECRET=    # signing secret of the Connect endpoint POST /c/stripe/webhook
# MEMBER_JWT_PRIVATE_KEY=   # optional ES256 private JWK (JSON) for member tokens
# SITE_KIT_LATEST=          # pin the update bot's latest site-kit version (else npm registry)
# SITE_KIT_CHANGELOG='[{"version":"0.2.0","notes":["…"]}]'
# NPM_REGISTRY=https://registry.npmjs.org

# Operator settings (abuse reporting, budget alerts, campaign warm-up). All optional.
# ABUSE_EMAIL=abuse@hub.example.com      # shown in every campaign email footer (PRD §9.3)
# ALERT_EMAIL=ops@hub.example.com        # budget alerts at 80% of the plan allowances (PRD §7.6)
# PLAN_ALLOWANCES_JSON='{"requests":10000000,"analyticsEvents":10000000,"emails":50000,"storageBytes":10737418240}'
# CAMPAIGN_DAILY_BASE=100                # campaign recipients per site per day for new senders
# CAMPAIGN_DAILY_MAX=50000               # ceiling the warm-up doubles toward
