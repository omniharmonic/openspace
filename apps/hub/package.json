{
  "name": "@openspace/hub",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpace Hub: the API worker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply openspace-hub --local && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply openspace-hub --local"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@openspace/email-render": "workspace:*",
    "@openspace/mcp-tools": "workspace:*",
    "@openspace/ops": "workspace:*",
    "@openspace/schema": "workspace:*",
    "@openspace/theme": "workspace:*",
    "blakejs": "^1.2.1",
    "fflate": "^0.8.3",
    "hono": "^4.9.0",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.40.0"
  }
}
