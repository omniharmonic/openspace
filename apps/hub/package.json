{
  "name": "@omniharmonic/openspace-hub",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpace Hub: the API worker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply openspace-hub --local && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply openspace-hub --local",
    "embed:starter": "node scripts/embed-starter.mjs",
    "embed:behaviors": "node scripts/embed-behaviors.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@omniharmonic/openspace-blocks": "workspace:*",
    "@omniharmonic/openspace-email-render": "workspace:*",
    "@omniharmonic/openspace-mcp-tools": "workspace:*",
    "@omniharmonic/openspace-ops": "workspace:*",
    "@omniharmonic/openspace-renderer": "workspace:*",
    "@omniharmonic/openspace-schema": "workspace:*",
    "@omniharmonic/openspace-site-kit": "workspace:*",
    "@omniharmonic/openspace-templates": "workspace:*",
    "@omniharmonic/openspace-theme": "workspace:*",
    "blakejs": "^1.2.1",
    "fflate": "^0.8.3",
    "hono": "^4.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.40.0"
  }
}
