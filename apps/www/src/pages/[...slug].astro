---
// Every page, collection item, list page and the 404 page of the site, rendered by
// @omniharmonic/openspace-site-kit from content/. Custom code belongs in src/overrides/ (Advanced).
import { renderPage, staticPaths } from "@omniharmonic/openspace-site-kit/route";

export const getStaticPaths = staticPaths;
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const html = await renderPage(Astro.props);
---
<Fragment set:html={html} />
