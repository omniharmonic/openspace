  "title": "About",
  "slug": "about",
  "seo": {
    "description": "OpenSpace is open source: MIT-licensed templates and blocks, an AGPL editor and Hub, and CC BY documentation. Anyone can run their own."
  },
  "sections": [
    {
      "id": "sec_71qavhdh4s",
      "preset": "hero/big-type@1",
