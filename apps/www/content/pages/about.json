                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Contributions of code, templates and documentation are welcome."
                    }
                  ]
                }
              ]
            }
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_59ymbpgt55",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "How to contribute",
            "link": {
              "type": "url",
              "url": "https://github.com/omniharmonic/openspace/blob/main/CONTRIBUTING.md"
            },
            "role": "secondary"
          },
          "column": 0,
          "variant": "default"
        },
        {
          "id": "blk_apae16fmfw",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Templates, blocks and the site starter",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MIT. Sites must be freely forkable, so everything a published site depends on is under the most permissive license."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "The Studio editor and the Hub",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "AGPL-3.0. If someone runs a modified copy for others, their improvements come back to the commons."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Documentation and template designs",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "CC BY 4.0. Remix them freely with attribution."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I run my own Hub?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. It's one Cloudflare Workers project with a Deploy to Cloudflare button, and any site can point at it."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "column": 1,
          "variant": "lines"
        }
