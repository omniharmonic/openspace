          "v": 1,
          "fields": {
            "text": "Honest answers about money",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Fine print"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_nzq1vwc4fc",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Who pays for the shared Hub?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A small stewarding group, funded by voluntary contributions and grants. Anyone can also run their own Hub."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you take a cut of sales or donations?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Never. Payments go to your own Stripe account with no platform fee. Stripe charges its usual card fees."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What about email newsletters?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Campaigns send through your own email provider, whose free tiers cover most small lists. Signups and opt-in emails are included."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Are there limits?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Generous fair-use limits on the public Hub keep it free, such as 1,000 form entries a month per site. Self-hosted Hubs set their own."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": true
          },
          "variant": "minimal"
        }
      ]
