          "fields": {
            "aspect": "auto",
            "height": 460,
            "embed": {
              "type": "code",
              "code": "<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml,body{margin:0;height:100%}\nbody{font:15px/1.5 system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#0e1233;background:#fff}\na{color:inherit}\n.wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);height:100%}\nform{padding:22px 24px;display:flex;flex-direction:column;gap:16px;min-width:0}\nfieldset{border:0;margin:0;padding:0;min-width:0}\nlegend,label{display:block;font-weight:600;margin:0 0 8px;padding:0}\n.chips{display:flex;flex-wrap:wrap;gap:6px}\n.chips label{margin:0;font-weight:500}\n.chips input{position:absolute;opacity:0;width:1px;height:1px}\n.chips span{display:inline-block;padding:7px 14px;border:1px solid #c9cee3;border-radius:999px;cursor:pointer;background:#fff}\n.chips input:checked+span{background:#0e1233;border-color:#0e1233;color:#fff}\n.chips input:focus-visible+span,select:focus-visible,input[type=number]:focus-visible,.give a:focus-visible{outline:3px solid #2c40e6;outline-offset:2px}\nselect,input[type=number]{width:100%;font:inherit;color:inherit;padding:9px 12px;border:1px solid #c9cee3;border-radius:10px;background:#fff}\n.fine{margin:auto 0 0;font-size:13px;color:#4d5370}\n.out{display:flex;flex-direction:column;gap:10px;padding:22px 24px;background:#0e1233;color:#e9ebff}\n.out p{margin:0}\n.lab{color:#b7bce3}\n.big{font-weight:650;font-size:clamp(44px,9vw,76px);line-height:1;letter-spacing:-.045em;color:#ffcb52;font-variant-numeric:tabular-nums}\n.big small{font-size:.32em;letter-spacing:0;font-weight:500;color:#e9ebff;margin-left:.3em}\n.more{color:#c9cdf0}\n.rule{height:1px;background:#2b3170;margin:6px 0}\n.give{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px}\n.give a{display:inline-block;padding:10px 16px;border-radius:999px;font-weight:600;text-decoration:none}\n.once{background:#ffcb52;color:#0e1233}\n.monthly{border:1px solid #6f77c4;color:#fff}\n.give a:hover{filter:brightness(1.08)}\n.other{font-size:14px}\n.js-only{display:none}\n.has-js .js-only{display:block}\n.has-js .no-js{display:none}\n@media (max-width:640px){\nhtml,body{background:#0e1233}\nform{background:#fff}\n.wrap{grid-template-columns:1fr;height:auto}\nform,.out{padding:18px}\n}\n</style>\n<div class=\"wrap\">\n<form id=\"f\" aria-describedby=\"fine\">\n<fieldset>\n<legend>Where does your site live today?</legend>\n<div class=\"chips\">\n<label><input type=\"radio\" name=\"p\" value=\"Squarespace\" checked><span>Squarespace</span></label>\n<label><input type=\"radio\" name=\"p\" value=\"Wix\"><span>Wix</span></label>\n<label><input type=\"radio\" name=\"p\" value=\"Webflow\"><span>Webflow</span></label>\n<label><input type=\"radio\" name=\"p\" value=\"other\"><span>Somewhere else</span></label>\n</div>\n</fieldset>\n<div id=\"planBox\">\n<label for=\"plan\">Your plan</label>\n<select id=\"plan\"><option value=\"0\">Basic, $19 a month</option><option value=\"1\">Core, $29 a month</option></select>\n</div>\n<div id=\"otherBox\" hidden>\n<label for=\"amt\">What you pay each month, in US dollars</label>\n<input id=\"amt\" type=\"number\" min=\"0\" max=\"2000\" step=\"1\" value=\"25\" inputmode=\"decimal\">\n</div>\n<p class=\"fine\" id=\"fine\">Published prices billed annually, read on 27 October 2026. Monthly billing costs more, so you may save more. A domain costs the same wherever you buy it, so it isn't counted.</p>\n</form>\n<div class=\"out\">\n<p class=\"lab\">Moving to OpenSpace keeps</p>\n<p class=\"big\" aria-live=\"polite\" aria-atomic=\"true\"><span id=\"year\">$228</span><small>a year</small></p>\n<p class=\"more\" id=\"three\">That's $684 over three years. Hosting on OpenSpace costs $0.</p>\n<div class=\"rule\" role=\"presentation\"></div>\n<p>OpenSpace stays free whatever you decide. If you'd like to give back a tenth of what you keep, it keeps the commons running:</p>\n<div class=\"give\">\n<a class=\"once\" id=\"once\" href=\"https://donate.stripe.com/bJe4gz9ss8828fL7uggMw01\" target=\"_blank\" rel=\"noopener\">Give <span id=\"onceAmt\">$25</span> once</a>\n<a class=\"monthly\" id=\"monthly\" href=\"https://buy.stripe.com/28EbJ1eMM9c6dA58ykgMw06\" target=\"_blank\" rel=\"noopener\">Give <span id=\"monthAmt\">$3</span> a month</a>\n</div>\n<p class=\"other\"><a href=\"https://donate.stripe.com/eVqcN55cc73Y0Nj29WgMw05\" target=\"_blank\" rel=\"noopener\">Choose your own amount</a><span class=\"no-js\">. Turn on JavaScript to try other plans; every way to give is listed beside this calculator.</span></p>\n<p class=\"fine\" style=\"color:#b7bce3\">Gifts go through Stripe's checkout and open in a new tab. They aren't tax-deductible.</p>\n</div>\n</div>\n<script>\n(()=> {\nvar D={\"plans\":[{\"provider\":\"Squarespace\",\"plan\":\"Basic\",\"monthly\":19},{\"provider\":\"Squarespace\",\"plan\":\"Core\",\"monthly\":29},{\"provider\":\"Wix\",\"plan\":\"Light\",\"monthly\":17},{\"provider\":\"Wix\",\"plan\":\"Core\",\"monthly\":29},{\"provider\":\"Webflow\",\"plan\":\"Basic\",\"monthly\":15},{\"provider\":\"Webflow\",\"plan\":\"Ecommerce Plus\",\"monthly\":74}],\"once\":{\"10\":\"https://donate.stripe.com/9B6eVdcEE1JE53zeWIgMw00\",\"25\":\"https://donate.stripe.com/bJe4gz9ss8828fL7uggMw01\",\"50\":\"https://donate.stripe.com/9B65kDbAAdsmfId29WgMw02\",\"100\":\"https://donate.stripe.com/7sY9AT3445ZUgMhaGsgMw03\",\"250\":\"https://donate.stripe.com/fZu00jaww8823Zvg0MgMw04\",\"custom\":\"https://donate.stripe.com/eVqcN55cc73Y0Nj29WgMw05\"},\"monthly\":{\"3\":\"https://buy.stripe.com/28EbJ1eMM9c6dA58ykgMw06\",\"5\":\"https://buy.stripe.com/bJe28r5cc4VQeE97uggMw07\",\"10\":\"https://buy.stripe.com/dRm3cv5cccoi7bH15SgMw08\",\"20\":\"https://buy.stripe.com/aFadR9fQQdsm9jPg0MgMw09\"}};\ndocument.documentElement.className=\"has-js\";\nvar f=document.getElementById(\"f\"),plan=document.getElementById(\"plan\"),amt=document.getElementById(\"amt\");\nvar planBox=document.getElementById(\"planBox\"),otherBox=document.getElementById(\"otherBox\");\nvar yearEl=document.getElementById(\"year\"),three=document.getElementById(\"three\");\nvar once=document.getElementById(\"once\"),onceAmt=document.getElementById(\"onceAmt\");\nvar monthly=document.getElementById(\"monthly\"),monthAmt=document.getElementById(\"monthAmt\");\nvar still=window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\nvar usd=(n)=> \"$\"+Math.round(n).toLocaleString(\"en-US\");\nvar tiers=(o)=> Object.keys(o).filter((k)=> k!==\"custom\").map(Number).sort((a,b)=> a-b);\nvar nearest=(ts,v)=> ts.reduce((a,b)=> Math.abs(b-v)<Math.abs(a-v)?b:a);\nvar shown=0,raf=0;\nfunction count(to){\ncancelAnimationFrame(raf);\nif(still){shown=to;yearEl.textContent=usd(to);return}\nvar from=shown,t0=performance.now();\n(function step(t){var k=Math.min(1,(t-t0)/450);k=1-(1-k) ** 3;shown=from+(to-from)*k;yearEl.textContent=usd(shown);if(k<1)raf=requestAnimationFrame(step)})(t0);\n}\nfunction provider(){var c=f.querySelector(\"input[name=p]:checked\");return c?c.value:\"Squarespace\"}\nfunction fill(){\nvar p=provider(),other=p===\"other\";\nplanBox.hidden=other;otherBox.hidden=!other;\nif(other)return;\nplan.innerHTML=\"\";\nD.plans.forEach((x,i)=> {if(x.provider!==p)return;var o=document.createElement(\"option\");o.value=i;o.textContent=x.plan+\", $\"+x.monthly+\" a month\";plan.appendChild(o)});\n}\nfunction update(){\nvar p=provider();\nvar m=p===\"other\"?Math.max(0,Math.min(2000,parseFloat(amt.value)||0)):D.plans[+plan.value].monthly;\nvar year=m*12;\ncount(year);\nthree.textContent=\"That's \"+usd(year*3)+\" over three years. Hosting on OpenSpace costs $0.\";\nvar o=nearest(tiers(D.once),Math.max(year*0.1,1)),mo=nearest(tiers(D.monthly),Math.max(m*0.1,1));\nonce.href=D.once[o];onceAmt.textContent=\"$\"+o;\nmonthly.href=D.monthly[mo];monthAmt.textContent=\"$\"+mo;\n}\nf.addEventListener(\"change\",(e)=> {if(e.target.name===\"p\")fill();update()});\namt.addEventListener(\"input\",update);\nf.addEventListener(\"submit\",(e)=> {e.preventDefault()});\nshown=D.plans[+plan.value].monthly*12;\nfill();update();\n})();\n</script>"
            },
