      "blocks": [
        {
          "id": "blk_dkps25y0e4",
          "type": "heading",
          "v": 1,
          "fields": {
            "text": "Plain answers about gifts",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Before you give"
          },
          "variant": "plain",
          "style": {
            "align": {
              "d": "center"
            }
          }
        },
        {
          "id": "blk_j6k7jfm6qv",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Do I have to give to use OpenSpace?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. Every feature is free for everyone, forever, and giving changes nothing about your site or what you can do with it."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Who receives the money?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The small stewarding group that runs the shared Hub and develops OpenSpace. Gifts pay for the Hub's running costs and for development."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Is my gift tax-deductible?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. Gifts aren't tax-deductible unless this page says otherwise."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "How do I change or stop a monthly gift?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Any time, in two clicks: "
                        },
                        {
                          "type": "text",
                          "text": "manage your gift",
                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "https://billing.stripe.com/p/login/9B6eVdcEE1JE53zeWIgMw00"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " signs you in with the email you gave at checkout, then cancel or update your card. Cancelling takes effect right away."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "How are payments handled?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "By Stripe, on Stripe's own checkout page. OpenSpace never sees your card details."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I help without money?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes: design a template, improve the docs, report a bug, or move a friend's site home. Contributions of every kind are welcome on GitHub."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": false,
            "faqSchema": true
          },
          "variant": "minimal"
        }
      ]
    },
