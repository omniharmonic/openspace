        {
          "id": "blk_sgnxqwykwd",
          "type": "accordion",
          "v": 1,
          "fields": {
            "items": [
              {
                "question": "Is it really free?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Your site is served by GitHub Pages or your own Cloudflare account, both free. The shared service for forms and newsletters is built to cost cents per thousand sites."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do I need to know how to code?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. You edit everything visually in Studio, on a computer or a phone. Words like repository and build stay out of sight unless you go looking."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "What would I pay for?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Only optional extras: a custom domain from any registrar, and the usual card fees if you sell through Stripe. OpenSpace takes no cut."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I leave?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Any time. Your site is a normal project in your account that standard tools can build, and your form entries and subscribers export as spreadsheets."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "column": 1,
          "variant": "lines"
        }
      ]
