                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A free account is where your site's files live. No account yet? Studio walks you through making one."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "You're live",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Your name and tagline go in, and the site is online at a free address you can swap for your own domain."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "columns": "3",
            "aspect": "original"
