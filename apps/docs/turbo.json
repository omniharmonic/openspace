{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "public/**",
        "!public/skills/**",
        "astro.config.mjs",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/plugin/claude-app-skills/**",
        "$TURBO_ROOT$/plugin/skills/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugin/claude-app-skills/**",
        "$TURBO_ROOT$/plugin/skills/**"
      ]
    }
  }
}
